# 이 파일을 .env.local 로 복사한 뒤 필요한 값만 채우세요. 모두 선택 사항입니다.

# 요약 엔진을 "API 키"로 쓸 때만 필요 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAlex: 이메일을 넣으면 더 안정적인 요청 풀을 씁니다. API 키가 있으면 함께 넣으세요.
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Semantic Scholar: 키가 없어도 되지만 요청 제한에 자주 걸립니다. 무료 신청 가능.
S2_API_KEY=

# KCI(한국학술지인용색인) Open API 키. 있으면 KCI 검색이 켜집니다.
KCI_API_KEY=

# claude 명령어 위치를 직접 지정하고 싶을 때 (기본값: PATH에서 찾음)
CLAUDE_CLI_PATH=
