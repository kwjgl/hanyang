# 이 파일을 .env.local 로 복사해서 값을 채웁니다. Vercel에서는 Settings → Environment Variables에 같은 이름으로 넣습니다.

# [필수] Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [필수] 사용자 API 키를 암호화하는 서버 비밀값 (32자 이상 임의 문자열)
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 한 번 정하면 바꾸지 마세요. 바꾸면 저장된 API 키를 모두 다시 등록해야 합니다.
API_KEY_ENCRYPTION_SECRET=

# [권장] 가입할 수 있는 이메일·도메인 (쉼표로 구분). 비워 두면 주소를 아는 누구나 가입할 수 있습니다.
# 예: ALLOWED_EMAILS=@hanyang.ac.kr,someone@gmail.com
ALLOWED_EMAILS=

# [선택] 논문 검색 출처
OPENALEX_EMAIL=
OPENALEX_API_KEY=
S2_API_KEY=

# [개발용] 1이면 Supabase 없이 /preview 에서 예시 데이터로 화면을 볼 수 있습니다. 배포 환경에서는 비워 두세요.
STRATA_PREVIEW=

# (선택) 국내 논문 검색: 공공데이터포털 "한국연구재단_KCI 논문정보서비스" 일반 인증키(Decoding)
KCI_SERVICE_KEY=
